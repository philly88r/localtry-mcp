{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localtry-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "LOCALTRY_AUTH_URL": "https://localtry.com/mcp/authorize"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID"
    }
  ],
  "services": [
    {
      "binding": "LOCALTRY_API",
      "service": "localtry-crm"
    }
  ]
}
